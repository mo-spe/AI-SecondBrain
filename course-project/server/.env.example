PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/feynman_course
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
SERVE_WEB=false

# AI_PROVIDER=mock 时不调用外部模型；改为 openai-compatible 并填入下面三项即可启用真实 Provider。
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
# DeepSeek 结构化 JSON 任务建议关闭思考模式，避免隐藏推理占用 JSON 输出预算。
AI_DISABLE_THINKING=true

# 百度智能云短语音识别（课程第七次课要求）。凭证只填写在本地 .env，不要提交到 Git。
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ASR_TIMEOUT_MS=30000
