{
  "name": "AI-SecondBrain",
  "appid": "",
  "description": "AI 驱动的第二大脑：知识管理、间隔复习与知识社区（移动端）",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {
      "Push": {},
      "OAuth": {}
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\"/>",
          "<uses-permission android:name=\"android.permission.VIBRATE\"/>"
        ]
      },
      "ios": {
        "privacyDescription": {
          "NSMicrophoneUsageDescription": "用于语音快速记录知识"
        }
      },
      "sdkConfigs": {
        "push": {
          "unipush": {
            "version": "2",
            "offline": false
          }
        }
      }
    }
  },
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "requiredPrivateInfos": [],
    "permission": {},
    "optimization": {
      "subPackages": true
    },
    "lazyCodeLoading": "requiredComponents"
  },
  "h5": {
    "title": "AI-SecondBrain",
    "router": {
      "mode": "hash",
      "base": "/mobile/"
    },
    "devServer": {
      "port": 5173,
      "proxy": {
        "/api": {
          "target": "http://localhost:8080",
          "changeOrigin": true
        }
      }
    }
  },
  "vueVersion": "3"
}